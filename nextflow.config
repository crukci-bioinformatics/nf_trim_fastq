manifest
{
    mainScript = "main.nf"
    nextflowVersion = ">=25.10.0"
    version = "0.2"
    author = "Ashley Sawle"
    homePage = "https://github.com/crukci-bioinformatics/nf_trim_fastq"
    name = "Trim fastq with fastp to remove adapter content etc."
}

// Parameter names and types are declared in the `params` block at the top of
// main.nf. Only the defaults are set here.
params {
    // Directory contains untrimmed fastq files
    inputDir = "fastq"

    // Directory, relative to the launch directory, to which to write trimmed
    // fastq files and reports
    outputDir = "fastq_trimmed"

    // Glob pattern to match read 1/2 fastq files
    fastqPattern = "*r_{1,2}.fq.gz"

    // Additional options to pass to fastp
    fastpOptions = ""
}

// Destination for the files declared in the `output` block of main.nf.
// A profile setting params.outputDir does not reach this (config is evaluated
// before profiles are merged), so a profile must set outputDir directly.
outputDir = "${launchDir}/${params.outputDir}"

process {
    conda = "${projectDir}/conda.yaml"

    errorStrategy = {
        task.exitStatus in ([ 104, 134 ] + (137..140)) ? 'retry' : 'finish'
    }

    cpus   = 1
    memory = 1.GB
    time   = 1.h

    withName: 'runFastp' {
        // fastp 1.4.0 peak RSS reached ~21 GB at 8 threads on samples of
        // 190-490M reads, so 16 GB is not enough.
        cpus   = 8
        memory = 32.GB
        time   = 2.h
    }

    withName: 'runFastqc' {
        // FastQC >= 0.13 uses up to 4 threads per file, two files per task.
        cpus   = 8
        memory = 4.GB
        time   = 2.h
    }

    withName: 'runMultiqc' {
        cpus   = 1
        memory = 8.GB
        time   = 1.h
    }
}

conda.enabled = true
conda.useMamba = true

profiles {
    standard
    {
        process.executor = "local"
        // Clamp per-task requests to what the local executor offers.
        process.resourceLimits = [ cpus: 4, memory: 8.GB ]
        executor
        {
            cpus = 4
            memory = 8.GB
        }
    }

    bigserver
    {
        process.executor = "local"
        process.resourceLimits = [ cpus: 50, memory: 128.GB ]
        executor
        {
            cpus = 50
            memory = 128.GB
        }
    }

    cluster {
        process.executor = "slurm"
        executor {
            queueSize = 200
            pollInterval = '30 sec'
            jobName = { "'${task.name}'" }
        }
    }

    epyc {
        process.executor = "slurm"
        process.queue = 'epyc'
        executor {
            queueSize = 200
            pollInterval = '30 sec'
            jobName = { "'${task.name}'" }
        }
    }

    // Stub run with placeholder inputs and no software:
    //   nextflow run main.nf -stub-run -profile test
    test {
        process.executor = "local"
        process.resourceLimits = [ cpus: 2, memory: 4.GB, time: 1.h ]
        conda.enabled = false
        // A profile cannot reach the top-level outputDir through
        // params.outputDir, so set both.
        params.outputDir = "test_outputs"
        outputDir = "${launchDir}/test_outputs"
        params.inputDir = "${projectDir}/test/fastq"
    }
}
